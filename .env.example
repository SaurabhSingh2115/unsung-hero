# Gemini API key from AI Studio
GEMINI_API_KEY=
# Gemini model used for enrichment and drafts
GEMINI_MODEL=gemini-3.8-flash
# Where Gemini responses are cached to avoid repeat calls
AI_CACHE_DIR=../data/cache

# DB connection string (SQLite locally, Postgres in prod)
DATABASE_URL=sqlite:///./unsung.db

# Thank-you link template; {recipient} {message} {type} get filled in
RECOGNITION_LINK_TEMPLATE=https://example.com/recognize?to={recipient}&msg={message}&type={type}
# Name of the recognition tool shown in the UI
RECOGNITION_TOOL_NAME=gThanks

# Smallest group size shown in org-level views
MIN_GROUP_SIZE=5

# Backend URL used by the frontend
API_BASE_URL=http://localhost:8000
