# --- AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Cache all enrichment results here so demos don't hit rate limits
AI_CACHE_DIR=../data/cache

# --- Database ---
# SQLite by default; for Postgres: postgresql+psycopg://unsung:unsung@localhost:5432/unsung
DATABASE_URL=sqlite:///./unsung.db

# --- Recognition tool (FR-18, FR-23) ---
# Templated URL. Available placeholders: {recipient} {message} {type}
# Confirm exact gThanks go link before the demo; this generic fallback works anywhere.
RECOGNITION_LINK_TEMPLATE=https://example.com/recognize?to={recipient}&msg={message}&type={type}
RECOGNITION_TOOL_NAME=gThanks

# --- Privacy ---
MIN_GROUP_SIZE=5

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
